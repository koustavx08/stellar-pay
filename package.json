{
  "name": "stellar-pay",
  "private": true,
  "version": "1.0.0",
  "description": "Freighter-powered XLM payment dApp on the Stellar testnet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/testnet-smoke.ts",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contract:build": "cargo build --manifest-path contracts/Cargo.toml --target wasm32v1-none --release",
    "contract:deploy": "tsx scripts/deploy-contract.ts",
    "contract:verify": "tsx scripts/verify-contract.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
